    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@cucumber/cucumber": "^11.0.0",
    "@nestjs/cli": "^10.4.0",
