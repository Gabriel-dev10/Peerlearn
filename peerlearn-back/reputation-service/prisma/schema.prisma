generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Score {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  xp        Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scores")
}
