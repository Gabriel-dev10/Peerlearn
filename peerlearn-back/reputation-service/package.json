    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@cucumber/cucumber": "^11.0.0",
    "@nestjs/cli": "^10.4.0",
    "@types/node": "^22.0.0",
    "prisma": "^5.20.0",
    "typescript": "^5.6.0"
